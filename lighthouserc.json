{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4322 --ignore-lock",
      "startServerReadyPattern": "4322",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/blog",
        "http://localhost:4322/projects",
        "http://localhost:4322/about",
        "http://localhost:4322/now",
        "http://localhost:4322/blog/por-que-escolhi-astro"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
