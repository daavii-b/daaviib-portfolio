---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import PostList from '@/components/PostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getPosts, getProjects } from '@/lib/collections';

export const getStaticPaths = (async () => {
  const projects = await getProjects(DEFAULT_LOCALE);
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const lang = project.data.lang;
const { Content } = await render(project);
const related = (await getPosts(lang)).filter((post) => post.data.project?.id === project.id);
---

<BaseLayout title={project.data.name} description={project.data.summary}>
  <article>
    <h1 class="text-3xl font-bold tracking-tight">{project.data.name}</h1>
    <p class="mt-2 text-ink-muted">{project.data.summary}</p>
    <div class="prose mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
  {related.length > 0 && (
    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="mb-4 text-xl font-semibold">
        {t(lang, 'projects.relatedPosts')}
      </h2>
      <PostList posts={related} lang={lang} />
    </section>
  )}
</BaseLayout>
