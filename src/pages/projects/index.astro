---
import ProjectCard from '@/components/ProjectCard.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/collections';

const lang = DEFAULT_LOCALE;
const projects = await getProjects(lang);
---

<BaseLayout
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.description')}
  section={t(lang, 'nav.projects')}
  contact={{ kind: 'projects' }}
>
  <div class="mx-auto max-w-content px-5 pb-24 md:px-10">
    <header class="flex max-w-measure flex-col gap-4 pt-12 md:pt-24">
      <h1 class="text-display-lg">{t(lang, 'projects.title')}</h1>
      <p class="text-lg text-text-muted md:text-xl">{t(lang, 'projects.description')}</p>
    </header>
    {projects.length === 0 ? (
      <p class="mt-12 text-text-muted">{t(lang, 'projects.empty')}</p>
    ) : (
      <div class="mt-12 grid gap-10 sm:grid-cols-2 sm:gap-8">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} headingLevel="h2" />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
