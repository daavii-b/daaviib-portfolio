---
import PostCard from '@/components/PostCard.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/collections';

const lang = DEFAULT_LOCALE;
const posts = await getPosts(lang);
---

<BaseLayout
  title={t(lang, 'blog.title')}
  description={t(lang, 'blog.description')}
  section={t(lang, 'nav.blog')}
  contact={{ kind: 'blog' }}
>
  <div class="mx-auto max-w-content px-5 pb-24 md:px-10">
    <header class="flex max-w-measure flex-col gap-4 pt-12 md:pt-24">
      <h1 class="text-display-lg">{t(lang, 'blog.title')}</h1>
      <p class="text-lg text-text-muted md:text-xl">{t(lang, 'blog.lead')}</p>
    </header>
    {posts.length === 0 ? (
      <p class="mt-12 text-text-muted">{t(lang, 'blog.empty')}</p>
    ) : (
      <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} lang={lang} headingLevel="h2" />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
