---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';

import ContactCTA from '@/components/ContactCTA.astro';
import PostCover from '@/components/ui/PostCover.astro';
import Tag from '@/components/ui/Tag.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { formatDate, localizePath, t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/collections';
import { findTranslation, readingTime } from '@/lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts(DEFAULT_LOCALE);
  const allLocales = [...posts]; // add other locales' posts here when they exist
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post, allLocales },
  }));
}) satisfies GetStaticPaths;

const { post, allLocales } = Astro.props;
const lang = post.data.lang;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const firstTag = post.data.tags[0] ?? 'blog';

const alternates = (['en'] as const)
  .map((other) => findTranslation(allLocales, post, other))
  .filter((p) => p !== undefined)
  .map((p) => ({ lang: p.data.lang, path: localizePath(`/blog/${p.data.slug}`, p.data.lang) }));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  section={t(lang, 'nav.blog')}
  contact={{ kind: 'article', title: post.data.title }}
  type="article"
  publishedAt={post.data.publishedAt}
  alternates={alternates}
>
  <article class="mx-auto max-w-content px-5 pb-24 md:px-10">
    <header class="max-w-[760px] pt-6 md:pt-12">
      <a
        href={localizePath('/blog', lang)}
        class="-ml-1 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-text-muted hover:text-text"
      >
        ← {t(lang, 'blog.back')}
      </a>
      <p class="text-meta mt-4 text-text-muted md:mt-6">
        {`${t(lang, 'blog.publishedOn')} `}
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, lang)}</time>
        {` · ${t(lang, 'blog.readingTime', { minutes })}`}
      </p>
      <h1 class="text-display-lg mt-4 md:mt-5">{post.data.title}</h1>
      <p class="mt-3 text-lg text-text-muted md:mt-4 md:text-xl">{post.data.description}</p>
    </header>

    <div class="mt-8 md:mt-12">
      <PostCover keyword={post.data.keyword ?? firstTag} label={firstTag} size="wide" />
    </div>

    <div class="mt-10 max-w-measure md:mt-16">
      <div class="prose max-w-none md:prose-lg">
        <Content />
      </div>
      <div class="mt-10 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <Tag href={localizePath(`/blog/tags/${tag}`, lang)}>{tag}</Tag>
        ))}
      </div>
      <div class="mt-12">
        <ContactCTA lang={lang} kind="article" />
      </div>
    </div>
  </article>
</BaseLayout>
