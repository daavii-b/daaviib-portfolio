---
import PostList from '@/components/PostList.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { getPosts, getProjects } from '@/lib/collections';

const lang = DEFAULT_LOCALE;
const posts = (await getPosts(lang)).slice(0, 5);
const featured = (await getProjects(lang)).filter((p) => p.data.featured);
---

<BaseLayout>
  <section class="mb-12">
    <!-- TODO: replace with your real introduction. -->
    <h1 class="text-3xl font-bold tracking-tight">Olá! 👋</h1>
    <p class="mt-4 text-lg text-ink-muted">{t(lang, 'site.description')}</p>
  </section>

  {featured.length > 0 && (
    <section class="mb-12" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="mb-4 text-xl font-semibold">
        {t(lang, 'home.featuredProjects')}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {featured.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="posts-heading">
    <h2 id="posts-heading" class="mb-4 text-xl font-semibold">
      {t(lang, 'home.latestPosts')}
    </h2>
    <PostList posts={posts} lang={lang} />
  </section>
</BaseLayout>
