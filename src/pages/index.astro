---
import AvailabilityLine from '@/components/AvailabilityLine.astro';
import ClosingBox from '@/components/ClosingBox.astro';
import CopyEmailButton from '@/components/CopyEmailButton.astro';
import DefinitionList from '@/components/DefinitionList.astro';
import ExperienceList from '@/components/ExperienceList.astro';
import Icon from '@/components/icons/Icon.astro';
import PostList from '@/components/PostList.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/config/site';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getExperiences, getNow, getPosts, getProjects, getPublishedPaths } from '@/lib/collections';
import { resolveInternalLink } from '@/lib/links';

const lang = DEFAULT_LOCALE;
const [posts, projects, experiences, now, publishedPaths] = await Promise.all([
  getPosts(lang),
  getProjects(lang),
  getExperiences('work'),
  getNow(lang),
  getPublishedPaths(lang),
]);
const latestPosts = posts.slice(0, 3);
const featured = projects.filter((project) => project.data.featured);
const nowItems = (now?.data.items ?? []).map((item) => ({
  term: item.label,
  text: item.text,
  href: resolveInternalLink(item.href, publishedPaths),
}));
const mailto = `mailto:${SITE.contact.email}`;
---

<BaseLayout contact={{ kind: 'home' }}>
  <div class="mx-auto max-w-content px-5 pb-14 md:px-10 md:pb-24">
    <section aria-labelledby="hero" class="grid items-end gap-12 pt-12 md:grid-cols-12 md:pt-28">
      <div class="flex flex-col gap-5 md:col-span-7 md:gap-6">
        <AvailabilityLine lang={lang} />
        <h1 id="hero" class="text-display-xl">
          {t(lang, 'home.title')}
        </h1>
        <p class="text-lg text-text-muted md:text-xl">{t(lang, 'home.intro')}</p>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={localizePath('/projects', lang)} variant="primary" size="lg">
            {t(lang, 'home.seeProjects')}
          </Button>
          <Button href={mailto} size="lg" data-contact-open aria-haspopup="dialog">
            <Icon name="message" size={18} />
            {t(lang, 'contact.title')}
          </Button>
        </div>
      </div>

      {now && nowItems.length > 0 && (
        <section aria-labelledby="now" class="rounded-lg border border-border bg-bg p-6 md:col-span-5">
          <div class="mb-2 flex items-baseline justify-between gap-3">
            <h2 id="now" class="text-heading-sm">
              {t(lang, 'now.title')}
            </h2>
            <time datetime={now.data.updatedAt.toISOString().slice(0, 10)} class="text-meta text-text-muted">
              {now.data.updatedAt.toISOString().slice(0, 10)}
            </time>
          </div>
          <DefinitionList items={nowItems} termWidth="narrow" closed={false} />
          <a
            href={localizePath('/now', lang)}
            class="group/more mt-2 inline-flex items-center gap-1.5 py-2.5 text-[15px] font-semibold text-accent hover:text-accent-hover"
          >
            {t(lang, 'home.nowLink')}
            <span aria-hidden="true" class="transition-transform duration-200 group-hover/more:translate-x-1">
              →
            </span>
          </a>
        </section>
      )}
    </section>

    {featured.length > 0 && (
      <section aria-labelledby="featured" class="mt-16 md:mt-32">
        <SectionHeader
          id="featured"
          title={t(lang, 'home.featuredProjects')}
          href={localizePath('/projects', lang)}
          linkLabel={t(lang, 'home.allProjects')}
        />
        <div class="mt-6 grid gap-10 sm:grid-cols-2 sm:gap-8 md:mt-8">
          {featured.map((project) => (
            <ProjectCard project={project} lang={lang} />
          ))}
        </div>
      </section>
    )}

    {latestPosts.length > 0 && (
      <section aria-labelledby="latest" class="mt-16 md:mt-24">
        <SectionHeader
          id="latest"
          title={t(lang, 'home.latestPosts')}
          href={localizePath('/blog', lang)}
          linkLabel={t(lang, 'home.seeBlog')}
        />
        <div class="mt-4 md:mt-6">
          <PostList posts={latestPosts} lang={lang} />
        </div>
      </section>
    )}

    {experiences.length > 0 && (
      <section aria-labelledby="experience" class="mt-16 md:mt-24">
        <SectionHeader
          id="experience"
          title={t(lang, 'about.experience')}
          href={localizePath('/about', lang)}
          linkLabel={t(lang, 'home.aboutLink')}
        />
        <div class="mt-4 md:mt-6">
          <ExperienceList experiences={experiences} lang={lang} variant="summary" />
        </div>
      </section>
    )}

    <div class="mt-14 md:mt-24">
      <ClosingBox id="closing" title={t(lang, 'home.closingTitle')} text={t(lang, 'home.closingText')}>
        <Button href={mailto} variant="primary" size="lg" data-contact-open aria-haspopup="dialog">
          <Icon name="message" size={18} />
          {t(lang, 'contact.title')}
        </Button>
        <CopyEmailButton lang={lang} />
      </ClosingBox>
    </div>
  </div>
</BaseLayout>
