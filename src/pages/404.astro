---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';

const lang = DEFAULT_LOCALE;
---

<BaseLayout title={t(lang, 'notFound.title')}>
  <div class="mx-auto max-w-measure px-5 pt-12 pb-24 md:px-10 md:pt-24">
    <h1 class="text-display-lg">{t(lang, 'notFound.title')}</h1>
    <p class="mt-4">
      <a
        href={localizePath('/', lang)}
        class="text-accent underline underline-offset-4 hover:text-accent-hover"
      >
        {t(lang, 'notFound.back')}
      </a>
    </p>
  </div>
</BaseLayout>
