---
import NowStatus from '@/components/NowStatus.astro';
import { SITE } from '@/config/site';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { formatDate, formatShortDate, localizePath, t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNow, getPosts, getPublishedPaths } from '@/lib/collections';
import { resolveInternalLink } from '@/lib/links';
import { CHANGE_KINDS, CHANGE_SIGNS, parseStatus, resolveStatus, timeline, type ChangeKind } from '@/lib/now';
import { seriesPosts } from '@/lib/series';

const lang = DEFAULT_LOCALE;
const [now, posts, publishedPaths] = await Promise.all([
  getNow(lang),
  getPosts(lang),
  getPublishedPaths(lang),
]);

const [introBefore = '', introAfter = ''] = t(lang, 'now.intro').split('{link}');
const status = now ? resolveStatus(parseStatus(now.data.status), publishedPaths) : [];
const items = (now?.data.items ?? []).map((item, index) => ({
  ...item,
  id: `now-item-${index + 1}`,
  href: resolveInternalLink(item.href, publishedPaths),
  posts: item.series
    ? seriesPosts(item.series, lang, posts, (post) => localizePath(`/blog/${post.data.slug}`, lang))
    : [],
}));
const history = now ? timeline(now.data.history) : [];
const isoDay = (date: Date) => date.toISOString().slice(0, 10);

const signColor: Record<ChangeKind, string> = {
  added: 'text-accent',
  changed: 'text-text',
  removed: 'text-text-muted',
};
const link = 'underline decoration-border-strong underline-offset-4';
---

<BaseLayout
  title={t(lang, 'now.title')}
  description={t(lang, 'now.description')}
  section={t(lang, 'nav.now')}
  contact={{ kind: 'other' }}
>
  <article
    aria-labelledby="now-title"
    class="mx-auto max-w-content px-5 pt-10 pb-18 md:px-10 md:pt-24 md:pb-28"
  >
    <header class="flex flex-col gap-3.5 md:gap-4 md:pl-[180px]">
      <h1 id="now-title" class="text-display-lg">
        {t(lang, 'now.title')}
      </h1>
      <p class="max-w-measure text-[15px] leading-relaxed text-text-muted md:text-base">
        {introBefore}
        <a href={SITE.nowPageAbout} class:list={[link, 'text-text hover:text-accent']}>
          {t(lang, 'now.introLink')}
        </a>
        {introAfter}
      </p>
      {now && (
        <p class="text-meta flex flex-wrap items-baseline gap-2 text-text-muted">
          <span>
            {`${t(lang, 'now.updatedOn')} `}
            <time datetime={isoDay(now.data.updatedAt)} class="text-text">
              {formatDate(now.data.updatedAt, lang)}
            </time>
          </span>
          <span aria-hidden="true">·</span>
          <a href="#timeline" class:list={[link, 'hover:text-text']}>
            {t(lang, 'now.seeTimeline')}
          </a>
        </p>
      )}
    </header>

    {now && (
      <>
        <NowStatus
          segments={status}
          size="page"
          class="mt-7 max-w-lead md:mt-10 md:pl-[180px] md:max-w-[940px]"
        />

        <div class="mt-10 flex flex-col gap-8 md:mt-16 md:gap-10">
          {items.map((item) => (
            <section
              aria-labelledby={item.id}
              class="border-t border-border pt-5 md:grid md:grid-cols-[140px_minmax(0,680px)] md:gap-10 md:pt-7"
            >
              <p class="text-eyebrow mb-2 text-text-muted md:mb-0 md:pt-2">{item.label}</p>
              <div class="flex flex-col gap-2 md:gap-2.5">
                <h2 id={item.id} class="text-heading-sm md:text-heading-md">
                  {item.title}
                </h2>
                {item.text && <p class="text-[17px] leading-[1.7] md:text-lg">{item.text}</p>}
                {item.posts.length > 0 && (
                  <ol class="mt-1 flex flex-col gap-1.5">
                    {item.posts.map((post) => (
                      <li class="flex items-baseline gap-3">
                        <span aria-hidden="true" class="text-meta text-text-muted">
                          {post.number}
                        </span>
                        <a
                          href={post.href}
                          class:list={[link, 'text-[17px] leading-[1.7] hover:text-accent md:text-lg']}
                        >
                          {post.title}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
                {item.href && item.linkLabel && (
                  <div>
                    <a
                      href={item.href}
                      class="group/more inline-flex items-center gap-1.5 py-2.5 text-[15px] font-semibold text-accent hover:text-accent-hover"
                    >
                      {item.linkLabel}
                      <span
                        aria-hidden="true"
                        class="transition-transform duration-200 group-hover/more:translate-x-1"
                      >
                        →
                      </span>
                    </a>
                  </div>
                )}
              </div>
            </section>
          ))}
        </div>

        <section
          id="timeline"
          aria-labelledby="timeline-title"
          class="mt-14 scroll-mt-6 border-t border-border pt-6 md:mt-22 md:pt-8"
        >
          <div class="md:pl-[180px]">
            <h2 id="timeline-title" class="text-heading-sm md:text-heading-md">
              {t(lang, 'now.timeline')}
            </h2>
            <p class="mt-2 text-[15px] leading-relaxed text-text-muted md:text-base">
              {t(lang, 'now.timelineIntro')}
            </p>
            <ul aria-label={t(lang, 'now.legend')} class="mt-3 flex flex-wrap gap-4">
              {CHANGE_KINDS.map((kind) => (
                <li class="inline-flex items-baseline gap-1.5">
                  <span aria-hidden="true" class:list={['font-mono text-sm font-semibold', signColor[kind]]}>
                    {CHANGE_SIGNS[kind]}
                  </span>
                  <span class="text-[15px] text-text-muted md:text-base">
                    {t(lang, `now.change.${kind}`)}
                  </span>
                </li>
              ))}
            </ul>

            <ol class="mt-8">
              {history.map((entry) => (
                <li class="relative border-l border-border pb-8 pl-[22px] last:border-l-transparent last:pb-0">
                  <span
                    aria-hidden="true"
                    class:list={[
                      'absolute rounded-full',
                      entry.current
                        ? 'top-1.5 -left-1.5 size-[11px] bg-accent ring-4 ring-bg'
                        : 'top-[7px] -left-[5px] size-[9px] border border-border-strong bg-bg',
                    ]}
                  />
                  <div class="flex flex-wrap items-center gap-2.5">
                    <time
                      datetime={isoDay(entry.date)}
                      class:list={['text-meta', entry.current ? 'text-text' : 'text-text-muted']}
                    >
                      {formatShortDate(entry.date, lang)}
                    </time>
                    {entry.current && (
                      <span class="rounded-full bg-accent-subtle px-2 py-px text-xs font-semibold text-accent">
                        {t(lang, 'now.current')}
                      </span>
                    )}
                  </div>
                  {entry.note && (
                    <p class="mt-1.5 text-[15px] leading-relaxed text-text-muted md:text-base">
                      {entry.note}
                    </p>
                  )}
                  <ul class="mt-3 flex flex-col gap-1">
                    {entry.changes.map((change) => (
                      <li class="grid grid-cols-[16px_minmax(0,1fr)] items-baseline gap-2.5">
                        <span
                          aria-hidden="true"
                          class:list={['font-mono text-[15px] font-semibold', signColor[change.kind]]}
                        >
                          {CHANGE_SIGNS[change.kind]}
                        </span>
                        <span class="text-[15px] leading-relaxed md:text-base">
                          <span class="sr-only">{`${t(lang, `now.change.${change.kind}`)}: `}</span>
                          {change.text}
                        </span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </>
    )}
  </article>
</BaseLayout>
