---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import AvailabilityLine from '@/components/AvailabilityLine.astro';
import ClosingBox from '@/components/ClosingBox.astro';
import DefinitionList from '@/components/DefinitionList.astro';
import ExperienceList from '@/components/ExperienceList.astro';
import Icon from '@/components/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/config/site';
import { DEFAULT_LOCALE } from '@/i18n/config';
import { t } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAboutProfile, getExperiences } from '@/lib/collections';
import { publicFileExists } from '@/lib/files';

const lang = DEFAULT_LOCALE;
const [profile, experiences] = await Promise.all([getAboutProfile(lang), getExperiences()]);
const mailto = `mailto:${SITE.contact.email}`;

// Optional assets: shown only when the files exist (see specs/002-home-about/data-model.md).
const CV_PATH = 'cv/davi-brito-cv.pdf';
const cvHref = publicFileExists(CV_PATH) ? `/${CV_PATH}` : undefined;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/davi.jpg', { eager: true });
const photo = Object.values(photos)[0]?.default;

const tools = (profile?.data.tools ?? []).map((tool) => ({ term: tool.label, text: tool.items.join(', ') }));
const education = [
  ...(profile?.data.education ?? []).map((item) => ({
    term: item.period,
    text: item.title,
    detail: item.institution,
  })),
  ...(profile?.data.languages ? [{ term: t(lang, 'about.languages'), text: profile.data.languages }] : []),
];
---

<BaseLayout
  title={t(lang, 'about.title')}
  description={profile?.data.lead}
  section={t(lang, 'nav.about')}
  contact={{ kind: 'about' }}
>
  <div class="mx-auto max-w-content px-5 pb-14 md:px-10 md:pb-24">
    <section
      aria-labelledby="about-title"
      class="grid items-end gap-6 pt-10 md:grid-cols-12 md:gap-12 md:pt-24"
    >
      <div class="flex flex-col gap-4 md:col-span-8 md:gap-5">
        <AvailabilityLine lang={lang} />
        <h1 id="about-title" class="text-display-xl">
          {t(lang, 'about.greeting')}
        </h1>
        {profile && <p class="text-lg text-text-muted md:text-xl">{profile.data.lead}</p>}
        <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={mailto} size="lg" data-contact-open aria-haspopup="dialog">
            <Icon name="message" size={18} />
            {t(lang, 'contact.title')}
          </Button>
          {cvHref && (
            <Button href={cvHref} size="lg" download>
              <Icon name="download" size={18} />
              {t(lang, 'about.cv')}
            </Button>
          )}
        </div>
      </div>
      {photo && (
        <div class="order-first md:order-none md:col-span-4">
          <Image
            src={photo}
            alt={t(lang, 'about.photoAlt')}
            widths={[360, 720]}
            sizes="(min-width: 768px) 320px, 100vw"
            loading="eager"
            class="aspect-[4/5] w-full rounded-lg border border-border object-cover"
          />
        </div>
      )}
    </section>

    {profile && (
      <section aria-labelledby="story" class="mt-14 flex max-w-measure flex-col gap-4 md:mt-24 md:gap-5">
        <h2 id="story" class="text-heading-lg">
          {t(lang, 'about.story')}
        </h2>
        {profile.data.story.map((paragraph) => (
          <p class="text-lg leading-relaxed">{paragraph}</p>
        ))}
      </section>
    )}

    {experiences.length > 0 && (
      <section aria-labelledby="experience" class="mt-14 md:mt-24">
        <h2 id="experience" class="text-heading-lg">
          {t(lang, 'about.experience')}
        </h2>
        <div class="mt-4 md:mt-6">
          <ExperienceList experiences={experiences} lang={lang} variant="highlights" />
        </div>
      </section>
    )}

    {tools.length > 0 && (
      <section aria-labelledby="tools" class="mt-14 md:mt-24">
        <h2 id="tools" class="text-heading-lg">
          {t(lang, 'about.tools')}
        </h2>
        <div class="mt-4 md:mt-6">
          <DefinitionList items={tools} />
        </div>
      </section>
    )}

    {education.length > 0 && (
      <section aria-labelledby="education" class="mt-14 md:mt-24">
        <h2 id="education" class="text-heading-lg">
          {t(lang, 'about.education')}
        </h2>
        <div class="mt-4 md:mt-6">
          <DefinitionList items={education} termStyle="meta" />
        </div>
      </section>
    )}

    <div class="mt-14 md:mt-24">
      <ClosingBox id="closing" title={t(lang, 'about.closingTitle')} text={t(lang, 'about.closingText')}>
        <Button href={mailto} variant="primary" size="lg" data-contact-open aria-haspopup="dialog">
          <Icon name="message" size={18} />
          {t(lang, 'contact.title')}
        </Button>
        {cvHref && (
          <Button href={cvHref} size="lg" solid download>
            <Icon name="download" size={18} />
            {t(lang, 'about.cv')}
          </Button>
        )}
      </ClosingBox>
    </div>
  </div>
</BaseLayout>
