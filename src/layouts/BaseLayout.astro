---
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SEO, { type Alternate } from '@/components/SEO.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import { HTML_LANG } from '@/i18n/config';
import { getLocaleFromPath, t } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Paths of this page in other locales (for hreflang and the language switcher). */
  alternates?: Alternate[];
  type?: 'website' | 'article';
  publishedAt?: Date;
}

const { title, description, alternates = [], type = 'website', publishedAt } = Astro.props;
const lang = getLocaleFromPath(Astro.url.pathname);
const siteTitle = t(lang, 'site.title');
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <ThemeScript />
    <SEO
      title={pageTitle}
      description={description ?? t(lang, 'site.description')}
      lang={lang}
      alternates={alternates}
      type={type}
      publishedAt={publishedAt}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:rounded focus:bg-surface focus:p-2"
    >
      {t(lang, 'nav.skip')}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
