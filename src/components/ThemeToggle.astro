---
import Icon from './icons/Icon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="inline-grid size-11 place-items-center rounded-full text-text-muted transition-colors duration-[120ms] hover:bg-surface hover:text-text"
>
  <Icon name="moon" class="dark:hidden" />
  <Icon name="sun" class="hidden dark:block" />
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        // Storage can be unavailable (private mode); the toggle still works for this page.
      }
    });
  }
</script>
