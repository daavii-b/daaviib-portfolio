---
import { SITE } from '@/config/site';
import type { Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { href: SITE.social.github, label: 'GitHub', rel: 'me' },
  { href: SITE.social.linkedin, label: 'LinkedIn', rel: 'me' },
  { href: localizePath('/rss.xml', lang), label: t(lang, 'footer.rss') },
];
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-wide flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-text-muted md:px-10">
    <p>
      © {year} {SITE.author}
    </p>
    <ul class="flex gap-6">
      {links.map((link) => (
        <li>
          <a href={link.href} rel={link.rel} class="transition-colors duration-[120ms] hover:text-text">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
