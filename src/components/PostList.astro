---
import type { CollectionEntry } from 'astro:content';

import type { Locale } from '@/i18n/config';
import { formatDate, localizePath, t } from '@/i18n/utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: Locale;
}

const { posts, lang } = Astro.props;
---

{posts.length === 0 ? (
  <p class="text-ink-muted">{t(lang, 'blog.empty')}</p>
) : (
  <ul class="space-y-6">
    {posts.map((post) => (
      <li>
        <article>
          <h3 class="text-lg font-semibold">
            <a href={localizePath(`/blog/${post.data.slug}`, lang)} class="hover:text-accent">
              {post.data.title}
            </a>
          </h3>
          <time datetime={post.data.publishedAt.toISOString()} class="text-sm text-ink-muted">
            {formatDate(post.data.publishedAt, lang)}
          </time>
          <p class="mt-1 text-ink-muted">{post.data.description}</p>
        </article>
      </li>
    ))}
  </ul>
)}
