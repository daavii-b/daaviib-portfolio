---
import type { CollectionEntry } from 'astro:content';

import type { Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';
import { readingTime } from '@/lib/content';

import PostCover from './ui/PostCover.astro';
import Tag from './ui/Tag.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { post, lang, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, publishedAt, tags, keyword, slug } = post.data;
const href = localizePath(`/blog/${slug}`, lang);
const firstTag = tags[0] ?? 'blog';
const minutes = readingTime(post.body ?? '');
---

<article class="group relative flex flex-col gap-3.5">
  <PostCover keyword={keyword ?? firstTag} label={firstTag} />
  <div class="flex flex-col gap-2">
    <p class="text-meta text-text-muted">
      <time datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0, 10)}</time>
      {` · ${t(lang, 'blog.readingTime', { minutes })}`}
    </p>
    <Heading class="text-heading-sm">
      <a
        href={href}
        class="text-text transition-colors duration-200 group-hover:text-accent after:absolute after:inset-0 after:content-['']"
      >
        {title}
      </a>
    </Heading>
    <p class="text-base text-text-muted">{description}</p>
    {tags.length > 0 && (
      <div class="relative z-10 mt-1 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Tag href={localizePath(`/blog/tags/${tag}`, lang)}>{tag}</Tag>
        ))}
      </div>
    )}
  </div>
</article>
