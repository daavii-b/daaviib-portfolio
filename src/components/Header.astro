---
import { ENABLED_LOCALES, type Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';

import type { Alternate } from './SEO.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
  alternates: Alternate[];
}

const { lang, alternates } = Astro.props;
const current = Astro.url.pathname;

const links = [
  { href: localizePath('/', lang), label: t(lang, 'nav.home') },
  { href: localizePath('/projects', lang), label: t(lang, 'nav.projects') },
  { href: localizePath('/blog', lang), label: t(lang, 'nav.blog') },
  { href: localizePath('/about', lang), label: t(lang, 'nav.about') },
  { href: localizePath('/now', lang), label: t(lang, 'nav.now') },
];

const isActive = (href: string) =>
  href === localizePath('/', lang) ? current === href : current.startsWith(href);

// Language switcher appears only once a second locale has content.
const showSwitcher = ENABLED_LOCALES.length > 1;
const otherLocales = alternates.filter((alt) => alt.lang !== lang);
---

<header class="border-b border-border">
  <nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4" aria-label="Main">
    <ul class="flex flex-1 flex-wrap gap-x-5 gap-y-2 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="text-ink-muted hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    {showSwitcher &&
      otherLocales.map((alt) => (
        <a href={alt.path} hreflang={alt.lang} class="text-sm uppercase text-ink-muted hover:text-ink">
          {alt.lang}
        </a>
      ))}
    <ThemeToggle label={t(lang, 'theme.toggle')} />
  </nav>
</header>
