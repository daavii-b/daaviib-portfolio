---
import type { CollectionEntry } from 'astro:content';

import type { Locale } from '@/i18n/config';
import { localizePath, t } from '@/i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { name, summary, status, stack, slug } = project.data;
---

<article class="rounded-lg border border-border p-4 hover:border-accent">
  <h3 class="font-semibold">
    <a href={localizePath(`/projects/${slug}`, lang)} class="hover:text-accent">
      {name}
    </a>
  </h3>
  <p class="mt-1 text-sm text-ink-muted">{summary}</p>
  <p class="mt-3 flex flex-wrap gap-2 text-xs">
    <span class="rounded bg-surface-muted px-2 py-0.5">{t(lang, `projects.status.${status}`)}</span>
    {stack.map((tech) => (
      <span class="rounded bg-surface-muted px-2 py-0.5">{tech}</span>
    ))}
  </p>
</article>
